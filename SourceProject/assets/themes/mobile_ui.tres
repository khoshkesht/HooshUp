[resource]
default_font = ExtResource("1_font")
default_font_size = 24
MobilePanel/base_type = &"PanelContainer"
MobilePanel/styles/panel = SubResource("Panel")
MobileButton/base_type = &"Button"
MobileButton/colors/font_color = Color(0.95, 0.98, 1, 1)
MobileButton/styles/normal = SubResource("Button")
MobileButton/styles/hover = SubResource("Hover")
